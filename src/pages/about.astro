---
import Hero from '~/components/widgets/Hero.astro';
import Stats from '~/components/widgets/Stats.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps2 from '~/components/widgets/Steps2.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Layout from '~/layouts/PageLayout.astro';

const metadata = {
  title: 'About — Hieu Tran',
  description: 'Learn more about Hieu Tran — Principal Engineer with 12+ years in software architecture, cloud infrastructure, and engineering leadership.',
};
---

<Layout metadata={metadata}>

  <Hero
    tagline="About Me"
    image={{
      src: 'https://hieutranspace.imgix.net/photos/HieuTranPhoto.jpg?auto=format&fit=crop&crop=top',
      alt: 'Hieu Tran',
    }}
  >
    <Fragment slot="title">
      Engineer, Leader,<br />
      <span class="text-accent dark:text-white highlight">Builder</span>
    </Fragment>

    <Fragment slot="subtitle">
      I'm Hieu Tran — a Principal Engineer based in Da Nang, Vietnam. For over 12 years, I've been building software systems, leading engineering teams, and helping companies modernize their technology. I believe great software comes from great teams, and I'm passionate about building both.
    </Fragment>
  </Hero>

  <Stats
    title="By the numbers"
    stats={[
      { title: 'Years in Tech', amount: '12+' },
      { title: 'Engineers Mentored', amount: '30+' },
      { title: 'Systems Architected', amount: '15+' },
      { title: 'Countries Served', amount: '5' },
    ]}
  />

  <Features3
    title="What I Do"
    subtitle="I operate at the intersection of architecture, leadership, and hands-on engineering."
    columns={3}
    isBeforeContent={true}
    items={[
      {
        title: 'System Architecture',
        description: 'Designing distributed systems and microservices that scale with business growth. From monolith migrations to greenfield builds.',
        icon: 'tabler:building-arch',
      },
      {
        title: 'Engineering Leadership',
        description: 'Building and mentoring high-performing teams. Defining OKRs, career paths, and engineering culture that ships.',
        icon: 'tabler:users-group',
      },
      {
        title: 'Cloud & DevOps',
        description: 'Azure, AWS, Kubernetes, Terraform — building production infrastructure with automation-first mindset.',
        icon: 'tabler:cloud',
      },
      {
        title: 'AI Adoption',
        description: 'Helping teams integrate AI into their workflows — from LLM-powered tools to intelligent automation pipelines.',
        icon: 'tabler:brain',
      },
      {
        title: 'Technical Strategy',
        description: 'Aligning technology decisions with business goals. Making pragmatic tradeoffs that deliver value.',
        icon: 'tabler:target',
      },
      {
        title: '.NET Ecosystem',
        description: '12+ years deep in .NET — from Framework to .NET 8. ABP, Entity Framework, gRPC, high-performance APIs.',
        icon: 'tabler:code',
      },
    ]}
  />

  <Steps2
    title="What I Believe"
    subtitle="Principles that guide how I build software and lead teams."
    items={[
      {
        title: 'Ship, then iterate',
        description: 'Perfect is the enemy of shipped. Get it working, get it in front of users, then make it better based on real feedback.',
      },
      {
        title: 'Invest in people first',
        description: 'Technology changes every few years. A strong engineering culture compounds forever. I spend more time on team growth than tech decisions.',
      },
      {
        title: 'Automate the boring stuff',
        description: 'If a human is doing repetitive work, something is broken. CI/CD, infrastructure as code, automated testing — automate everything.',
      },
    ]}
  />

  <Steps2
    title="The Journey"
    subtitle="From writing my first lines of code to leading engineering organizations."
    isReversed={true}
    items={[
      {
        title: 'HCMUS → First Steps (2008-2013)',
        description: 'Computer Science at Ho Chi Minh University of Science. Built the foundation in algorithms, data structures, and fell in love with building things.',
        icon: 'tabler:school',
      },
      {
        title: 'Growth Years (2013-2021)',
        description: 'From junior developer to senior engineer across multiple companies. Full-stack .NET, Android, cloud migrations. Learned that code is only half the job — the other half is understanding the problem.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Leadership & Architecture (2021-Present)',
        description: 'Head of Engineering at SmartDev, then Principal Engineer. Led teams of 12+, architected systems processing €10M/month, and discovered that the most impactful engineering is enabling others to do their best work.',
        icon: 'tabler:rocket',
      },
    ]}
  />

  <CallToAction
    title="Let's connect"
    subtitle="Whether you want to discuss architecture, leadership, or just talk tech — I'm always up for a good conversation."
    actions={[
      {
        variant: 'primary',
        text: 'LinkedIn',
        href: 'https://www.linkedin.com/in/trankimhieu',
      },
      {
        text: 'X / Twitter',
        href: 'https://x.com/hieutk_',
      },
      {
        text: 'GitHub',
        href: 'https://github.com/tkhieu',
      },
    ]}
  />

</Layout>
