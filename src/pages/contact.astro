---
import Layout from '~/layouts/PageLayout.astro';
import HeroText from '~/components/widgets/HeroText.astro';
import Features2 from '~/components/widgets/Features2.astro';

const metadata = {
  title: 'Contact — Hieu Tran',
  description: 'Get in touch with Hieu Tran for engineering consulting, architecture advice, or collaboration.',
};
---

<Layout metadata={metadata}>

  <HeroText tagline="Contact" title="Let's Talk" subtitle="I'm always open to discussing engineering challenges, architecture decisions, or potential collaboration. Here's how to reach me." />

  <Features2
    title="Get in Touch"
    columns={3}
    items={[
      {
        title: 'LinkedIn',
        description: 'Best for professional inquiries and networking.',
        icon: 'tabler:brand-linkedin',
      },
      {
        title: 'X / Twitter',
        description: '@hieutk_ — DMs open for quick conversations.',
        icon: 'tabler:brand-x',
      },
      {
        title: 'Email',
        description: 'tr.kimhieu@gmail.com',
        icon: 'tabler:mail',
      },
      {
        title: 'GitHub',
        description: 'github.com/tkhieu — Check out my open source work.',
        icon: 'tabler:brand-github',
      },
      {
        title: 'Location',
        description: 'Da Nang, Vietnam 🇻🇳',
        icon: 'tabler:map-pin',
      },
      {
        title: 'Timezone',
        description: 'ICT (UTC+7) — Usually available 9AM-10PM.',
        icon: 'tabler:clock',
      },
    ]}
  />

</Layout>
