---
import Layout from '~/layouts/PageLayout.astro';

import Header from '~/components/widgets/Header.astro';
import Hero from '~/components/widgets/Hero.astro';
import Content from '~/components/widgets/Content.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';
import Features3 from '~/components/widgets/Features3.astro';
import Steps from '~/components/widgets/Steps.astro';
import BlogLatestPosts from '~/components/widgets/BlogLatestPosts.astro';
import { getPermalink } from '~/utils/permalinks';

const metadata = {
  title: 'Hieu Tran — Engineer, Architect, Leader',
  ignoreTitleTemplate: true,
};
---

<Layout metadata={metadata}>
  <Fragment slot="announcement"></Fragment>
  <Fragment slot="header">
    <Header
      links={[
        { text: 'Home', href: '#' },
        { text: 'About', href: '#about' },
        { text: 'Experience', href: '#resume' },
        { text: 'Portfolio', href: '#portfolio' },
        { text: 'Blog', href: '#blog' },
      ]}
      actions={[
        {
          text: 'Connect on LinkedIn',
          href: 'https://www.linkedin.com/in/trankimhieu',
        },
      ]}
      isSticky
      showToggleTheme
    />
  </Fragment>

  <!-- Hero Widget -->

  <Hero
    id="hero"
    title="Hieu Tran"
    tagline="Principal Engineer · Da Nang, Vietnam"
    actions={[
      { variant: 'primary', text: 'View My Work', href: '#portfolio' },
      { text: 'Get in Touch', href: 'https://www.linkedin.com/in/trankimhieu' },
    ]}
  >
    <Fragment slot="subtitle">
      12+ years building systems that scale, leading teams that ship, and turning complex problems into elegant solutions.<br /><br />
      I specialize in <strong>distributed architecture</strong>, <strong>cloud infrastructure</strong>, and <strong>AI adoption</strong> — helping companies modernize their tech stack and engineering culture.
    </Fragment>
  </Hero>

  <!-- About Widget -->

  <Content
    id="about"
    columns={3}
    items={[
      {
        icon: 'tabler:brand-github',
        callToAction: {
          target: '_blank',
          text: 'GitHub',
          href: 'https://github.com/tkhieu',
        },
      },
      {
        icon: 'tabler:brand-linkedin',
        callToAction: {
          target: '_blank',
          text: 'LinkedIn',
          href: 'https://www.linkedin.com/in/trankimhieu',
        },
      },
      {
        icon: 'tabler:brand-x',
        callToAction: {
          target: '_blank',
          text: 'X / Twitter',
          href: 'https://x.com/hieutk_',
        },
      },
    ]}
    image={{
      src: 'https://hieutranspace.imgix.net/photos/HieuTranPhoto.jpg?auto=format&fit=crop&crop=top',
      alt: 'Hieu Tran',
      loading: 'eager',
    }}
  >
    <Fragment slot="content">
      <h2 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">About me</h2>
      <p>
        I'm a Principal Engineer based in Da Nang, Vietnam, with over 12 years of experience building software that matters. My journey has taken me from writing my first .NET applications to architecting systems that handle millions in revenue.
      </p>
      <br />
      <p>
        What drives me is the intersection of <strong>great architecture and great teams</strong>. I've led engineering organizations, migrated legacy monoliths to cloud-native microservices, and helped companies adopt AI into their workflows — always with a focus on pragmatic solutions over hype.
      </p>
      <br />
      <p>
        When I'm not deep in code or architecture diagrams, you'll find me exploring the latest in AI tooling, contributing to open source, or mentoring the next generation of Vietnamese engineers. I believe the best technology serves people — and the best engineers never stop learning.
      </p>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- Work Experience -->

  <Steps
    id="resume"
    title="Work Experience"
    items={[
      {
        title:
          'Principal Engineer <br /> <span class="text-sm font-normal">2024 — Present · Da Nang, Vietnam</span>',
        description: `Driving architecture decisions and engineering excellence across the organization. Leading AI adoption strategy, establishing engineering standards, and mentoring senior engineers. Focused on building scalable, maintainable systems that enable rapid product iteration.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Head of Engineering & .NET Tech Lead <br /> <span class="font-normal">SmartDev LLC</span> <br /> <span class="text-sm font-normal">2021 — 2024 · Da Nang, Vietnam</span>',
        description: `Led a 12+ member engineering team while serving on the Head of Technology leadership group. Migrated a critical Food Ordering System from .NET Framework to .NET Core with microservice architecture deployed on Azure Kubernetes Service (Terraform IaC). The system processes €10M/month in revenue across Ireland with 200+ B2B users. <br /><br />
        Key achievements: <br />
        ■ Organized 5+ DevOps workshops, driving DevOps culture adoption across ODC teams <br />
        ■ Led junior team to build SmartDev Platform and SmartDev App (flagship internal products) <br />
        ■ Defined OKRs and career growth paths for all team members`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Senior .NET Developer <br /> <span class="font-normal">MagicMemories</span> <br /> <span class="text-sm font-normal">2018 — 2021</span>',
        description: `Architected and built MagicMemories OS v2 — a ground-up microservices platform powering digital transformation for the world's largest theme park photo company. Delivered significant cloud cost savings through infrastructure optimization and modern architecture patterns.`,
        icon: 'tabler:briefcase',
      },
      {
        title:
          'Software Developer <br /> <span class="text-sm font-normal">2013 — 2018</span>',
        description: `Built full-stack web applications and Android apps across multiple domains. Developed strong foundations in .NET ecosystem, database design, and agile delivery. Progressive growth from junior to senior roles.`,
        icon: 'tabler:briefcase',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Education -->

  <Steps
    title="Education"
    items={[
      {
        title: `Bachelor of Computer Science <br /> <span class="font-normal">Ho Chi Minh University of Science (HCMUS)</span> <br /> <span class="text-sm font-normal">2008 — 2013</span>`,
        description: 'Specialized in Software Engineering at one of Vietnam\'s top computer science programs. Built the foundation for a career spanning distributed systems, cloud architecture, and engineering leadership.',
        icon: 'tabler:school',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Skills -->

  <Features3
    title="Skills & Expertise"
    subtitle="The tools and practices I bring to every project."
    columns={3}
    defaultIcon="tabler:point-filled"
    items={[
      {
        title: 'System Architecture',
        description: 'Designing distributed systems, microservices, and event-driven architectures that handle millions in transaction volume.',
      },
      {
        title: 'Cloud & Infrastructure',
        description: 'Azure, AWS, Kubernetes, Docker, Terraform — building and operating production infrastructure at scale.',
      },
      {
        title: 'Engineering Leadership',
        description: 'Growing teams from 5 to 15+, defining career paths, running effective 1:1s, and building a culture of ownership.',
      },
      {
        title: '.NET & Backend',
        description: '12+ years in the .NET ecosystem — from Framework to .NET 8, ABP, Entity Framework, gRPC, and high-performance APIs.',
      },
      {
        title: 'AI & Automation',
        description: 'Adopting AI into engineering workflows — from LLM integration to building intelligent automation pipelines.',
      },
      {
        title: 'DevOps & CI/CD',
        description: 'GitHub Actions, Azure DevOps, Docker, Helm charts — automating everything from build to production deployment.',
      },
    ]}
  />

  <!-- My Approach -->

  <Features3
    title="My Engineering Philosophy"
    subtitle="Principles that guide how I build and lead."
    columns={2}
    defaultIcon="tabler:bulb"
    items={[
      {
        title: 'Pragmatism Over Perfection',
        description: 'Ship something that works, then iterate. The best architecture is the one your team can actually maintain.',
      },
      {
        title: 'Teams > Technology',
        description: 'A great team with average tools will outperform a mediocre team with the best stack. Invest in people first.',
      },
      {
        title: 'Automate Everything',
        description: 'If you do it twice, script it. If you do it three times, build a pipeline. Human time is too valuable for repetitive work.',
      },
      {
        title: 'Learn in Public',
        description: 'Share what you know, admit what you don\'t. The tech community grows when we teach each other openly.',
      },
    ]}
  />

  <!-- Portfolio -->

  <Content
    id="portfolio"
    title="Featured Projects"
    subtitle="Real systems, real impact."
    isReversed
    items={[
      {
        title: 'Challenge:',
        description:
          'Migrate a monolithic .NET Framework food ordering system to a modern, scalable architecture — without downtime — for a business processing €10M/month across Ireland.',
      },
      {
        title: 'Solution:',
        description:
          'Designed and implemented a microservice architecture using .NET Core + ABP Framework, deployed on Azure Kubernetes Service with Terraform IaC. Built CI/CD pipelines for zero-downtime deployments across multiple regions.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1658248165252-71e116af1b34?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=928&q=80',
      alt: 'Allsop RASP',
    }}
    callToAction={{
      target: '_blank',
      text: 'View project details',
      icon: 'tabler:chevron-right',
      href: './projects/allsop-rasp',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        Allsop RASP <br /><span class="text-2xl font-normal">Global food distribution management system</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent={true}
    items={[
      {
        title: 'Challenge:',
        description:
          'MagicMemories needed to transform their legacy photo processing system into a cloud-native platform, reducing operational costs while scaling to handle theme park traffic spikes worldwide.',
      },
      {
        title: 'Solution:',
        description:
          'Built MagicMemories OS v2 from the ground up as a microservices system. Implemented event-driven architecture for real-time photo processing, optimized cloud resource utilization, and delivered significant cost savings.',
      },
    ]}
    image={{
      src: '~/assets/images/blog/magicmemories-microservices.png',
      alt: 'MagicMemories OS v2',
    }}
    callToAction={{
      target: '_blank',
      text: 'View project details',
      icon: 'tabler:chevron-right',
      href: './projects/magicmemories-os-v2',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        MagicMemories OS v2 <br /><span class="text-2xl font-normal">Microservices platform for digital transformation</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <Content
    isReversed
    isAfterContent={true}
    items={[
      {
        title: 'What it does:',
        description:
          'A self-hosted AI assistant that monitors 14 Telegram channels, tracks X/Twitter timelines, scrapes Reddit across 11 subreddits, performs daily stock & crypto technical analysis, and delivers hourly intelligence summaries.',
      },
      {
        title: 'Built with:',
        description:
          'Node.js, Python (yfinance, pandas, ta), Telegram API, X API, OpenClaw framework. Self-hosted on a $5/month VPS. Total monthly cost: $0 for core functionality.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1677442136019-21780ecad995?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=928&q=80',
      alt: 'AI Assistant',
    }}
  >
    <Fragment slot="content">
      <h3 class="text-2xl font-bold tracking-tight dark:text-white sm:text-3xl mb-2">
        AI-Powered Intelligence Assistant <br /><span class="text-2xl font-normal">Weekend project that runs my information diet</span>
      </h3>
    </Fragment>

    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- CTA -->

  <CallToAction
    title="Let's build something great"
    subtitle="Whether you need architecture advice, engineering leadership, or just want to talk tech — I'm always up for a good conversation."
    actions={[
      {
        variant: 'primary',
        text: 'Connect on LinkedIn',
        href: 'https://www.linkedin.com/in/trankimhieu',
      },
      {
        text: 'Follow on X',
        href: 'https://x.com/hieutk_',
      },
    ]}
  />

  <!-- Blog -->

  <BlogLatestPosts
    id="blog"
    title="From the blog"
    information="Thoughts on engineering, architecture, AI, and building things that matter."
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </BlogLatestPosts>
</Layout>
