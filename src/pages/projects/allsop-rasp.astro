---
import Layout from '~/layouts/PageLayout.astro';

import Hero2 from '~/components/widgets/Hero2.astro';
import Features from '~/components/widgets/Features.astro';
import Content from '~/components/widgets/Content.astro';
import Steps from '~/components/widgets/Steps.astro';
import CallToAction from '~/components/widgets/CallToAction.astro';

const metadata = {
  title: 'Allsop RASP — Global Food Distribution System',
  description: 'Case study: Migrating a €10M/month food ordering monolith to .NET Core microservices on Azure Kubernetes Service.',
};
---

<Layout metadata={metadata}>

  <Hero2
    tagline="Case Study"
    image={{
      src: 'https://images.unsplash.com/photo-1658248165252-71e116af1b34?ixlib=rb-4.0.3&ixid=M3wxMjA3fDB8MHxwaG90by1wYWdlfHx8fGVufDB8fHx8fA%3D%3D&auto=format&fit=crop&w=2070&q=80',
      alt: 'Allsop RASP System',
    }}
  >
    <Fragment slot="title">
      Allsop RASP<br /><span class="text-accent dark:text-white text-3xl">Global Food Distribution Management System</span>
    </Fragment>

    <Fragment slot="subtitle">
      Migrating a €10M/month monolith to cloud-native microservices — without a single minute of downtime.
    </Fragment>
  </Hero2>

  <!-- The Challenge -->

  <Content
    title="The Challenge"
    isReversed
    items={[
      {
        title: 'Legacy .NET Framework monolith',
        description: 'The existing system was built on .NET Framework — aging, difficult to deploy, and hitting scaling limits as the business grew across Ireland.',
      },
      {
        title: 'High-stakes migration',
        description: 'Processing €10M/month in food distribution orders with 200+ B2B users. Any downtime meant real revenue loss and broken supply chains.',
      },
      {
        title: 'Team scaling',
        description: 'Needed to grow the engineering team while simultaneously rebuilding the platform — without disrupting ongoing delivery.',
      },
    ]}
    image={{
      src: 'https://images.unsplash.com/photo-1504868584819-f8e8b4b6d7e3?ixlib=rb-4.0.3&auto=format&fit=crop&w=928&q=80',
      alt: 'Challenge',
    }}
  >
    <Fragment slot="bg">
      <div class="absolute inset-0 bg-blue-50 dark:bg-transparent"></div>
    </Fragment>
  </Content>

  <!-- The Solution -->

  <Features
    title="The Solution"
    subtitle="A modern, cloud-native architecture built for scale and reliability."
    columns={3}
    items={[
      {
        title: '.NET Core + ABP Framework',
        description: 'Clean architecture patterns out of the box, with modular design enabling independent service development and deployment.',
        icon: 'tabler:code',
      },
      {
        title: 'Azure Kubernetes Service',
        description: 'Container orchestration with auto-scaling, self-healing, and blue-green deployments for zero-downtime releases.',
        icon: 'tabler:cloud',
      },
      {
        title: 'Terraform IaC',
        description: 'Infrastructure as Code for repeatable, version-controlled deployments across development, staging, and production environments.',
        icon: 'tabler:settings-automation',
      },
      {
        title: 'Event-Driven Architecture',
        description: 'Decoupled services communicating via events, enabling independent scaling and graceful failure handling.',
        icon: 'tabler:arrows-split-2',
      },
      {
        title: 'CI/CD Pipelines',
        description: 'Automated build, test, and deployment pipelines reducing release cycles from hours to minutes.',
        icon: 'tabler:refresh',
      },
      {
        title: 'Strangler Fig Pattern',
        description: 'Incremental migration strategy — replacing monolith components one by one while keeping the system running.',
        icon: 'tabler:plant',
      },
    ]}
  />

  <!-- My Role -->

  <Steps
    title="My Role"
    items={[
      {
        title: 'Architecture & Technical Leadership',
        description: 'Designed the microservice architecture, defined service boundaries, and made key technology decisions (AKS, ABP, event-driven patterns).',
        icon: 'tabler:bulb',
      },
      {
        title: 'Team Building & Mentorship',
        description: 'Led a 12+ member team including junior developers. Organized DevOps workshops, defined OKRs, and created career growth paths.',
        icon: 'tabler:users',
      },
      {
        title: 'Migration Execution',
        description: 'Executed the Strangler Fig migration over multiple phases, ensuring zero downtime and continuous feature delivery throughout.',
        icon: 'tabler:rocket',
      },
      {
        title: 'Infrastructure & DevOps',
        description: 'Set up Terraform-managed AKS clusters, CI/CD pipelines, monitoring, and alerting. Established DevOps culture across the team.',
        icon: 'tabler:server',
      },
    ]}
    classes={{ container: 'max-w-3xl' }}
  />

  <!-- Results -->

  <Features
    title="Results"
    subtitle="Measurable impact across business, technology, and team."
    columns={3}
    items={[
      {
        title: '€10M/month',
        description: 'Revenue processed with zero downtime during the entire migration.',
        icon: 'tabler:currency-euro',
      },
      {
        title: '200+ B2B Users',
        description: 'Across Ireland, with architecture ready for US and European expansion.',
        icon: 'tabler:users',
      },
      {
        title: 'Minutes, Not Hours',
        description: 'Deployment time reduced from hours of manual work to automated minutes.',
        icon: 'tabler:clock',
      },
      {
        title: 'Team Growth',
        description: 'Junior developers grew into confident service owners through mentorship and hands-on experience.',
        icon: 'tabler:trending-up',
      },
      {
        title: 'Multi-Region Ready',
        description: 'Terraform IaC enables one-command deployment to new regions as business expands.',
        icon: 'tabler:world',
      },
      {
        title: 'DevOps Culture',
        description: '5+ workshops delivered, shifting team mindset from manual ops to automation-first.',
        icon: 'tabler:heart-handshake',
      },
    ]}
  />

  <CallToAction
    title="Interested in working together?"
    subtitle="I help companies modernize their tech stack and build engineering teams that ship."
    actions={[
      {
        variant: 'primary',
        text: 'Connect on LinkedIn',
        href: 'https://www.linkedin.com/in/trankimhieu',
      },
    ]}
  />

</Layout>
